# ─────────────────────────────────────────────────────────────
# Healthcare IoT Honeypot — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Honeypot Device Identity ───────────────────────────────────
HONEYPOT_HOSTNAME=infusion-pump-01
HONEYPOT_SSH_PORT=2222
HONEYPOT_TELNET_PORT=2323
HONEYPOT_HTTP_PORT=8080

# ── Network Settings ───────────────────────────────────────────
# CIDR of your internal hospital network
# Alerts fire if any IP in this range connects to a honeypot
INTERNAL_NETWORK_CIDR=192.168.1.0/24

# ── Database ───────────────────────────────────────────────────
HONEYPOT_DB=honeypot.db

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=5000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_SECRET_KEY=change_me_to_a_random_string_in_production

# ── Alerting — Email ──────────────────────────────────────────
ALERT_EMAIL=security@yourhospital.com
SMTP_HOST=smtp.yourhospital.com
SMTP_PORT=587
SMTP_USER=alerts@yourhospital.com
SMTP_PASS=your_smtp_password

# ── Alerting — Slack ──────────────────────────────────────────
# Create a Slack app and enable Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK

# ── GeoIP ─────────────────────────────────────────────────────
# Free account at: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=your_maxmind_license_key
